{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cashu-fault-lab.local/schemas/lifecycle-release-suite.schema.json",
  "title": "Cashu Fault Lab lifecycle release suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "releaseSuiteDigest",
    "minimumWalletImplementations",
    "minimumMintImplementations",
    "requireCrossLanguage",
    "requireDistinctBuilds",
    "requireReplayEvidence",
    "allowSkippedRequired",
    "requiredOperations",
    "requiredScenarios",
    "requiredInvariants"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "wallet-lifecycle-v1" },
    "releaseSuiteDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "minimumWalletImplementations": { "type": "integer", "minimum": 2, "maximum": 16 },
    "minimumMintImplementations": { "type": "integer", "minimum": 2, "maximum": 16 },
    "requireCrossLanguage": { "const": true },
    "requireDistinctBuilds": { "const": true },
    "requireReplayEvidence": { "const": true },
    "allowSkippedRequired": { "const": false },
    "requiredOperations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "enum": ["mint", "swap", "send", "receive", "melt", "restore", "reconcile"] }
    },
    "requiredScenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
    },
    "requiredInvariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
    }
  }
}
