{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cashu-fault-lab.dev/schemas/adapter-capabilities.schema.json",
  "title": "Cashu Fault Lab Adapter Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "implementation", "roles", "nuts", "encodings", "mints"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "language", "runtime", "sourceDigest", "buildDigest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "language": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "runtime": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "buildDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sender": { "$ref": "#/$defs/role" },
        "receiver": { "$ref": "#/$defs/role" }
      }
    },
    "nuts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "encodings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["creqA", "creqB"] }
    },
    "mints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mint" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!([0-9a-f])\\1{63}$)[0-9a-f]{64}$"
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transports", "profiles", "durability", "evidence"],
      "properties": {
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["http", "nostr"] }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "durability": { "enum": ["process", "persistent", "restart_safe"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "sources"],
          "properties": {
            "tier": { "enum": ["T0", "T1", "T2", "T3"] },
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "adapter",
                  "runner",
                  "transport",
                  "mint",
                  "durable_ledger",
                  "durable_state"
                ]
              }
            }
          }
        }
      }
    },
    "mint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "implementation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "implementation": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
