{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cashu-fault-lab.dev/schemas/wallet-doctor-scenario.schema.json",
  "title": "NIP-60 Wallet Doctor Scenario",
  "description": "Canonical documentation of the scenario format executed by wallet-doctor run/matrix. Runtime validation is enforced in code by @cashu-fault-lab/wallet-doctor-runner (validateWalletDoctorScenario); this schema is the language-neutral contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description", "commands", "expect"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "amount"],
            "properties": {
              "op": { "const": "mint" },
              "amount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "amount", "mode"],
            "properties": {
              "op": { "const": "spend" },
              "amount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "mode": {
                "enum": [
                  "clean",
                  "partial-delete",
                  "partial-publish",
                  "ghost",
                  "delete-only",
                  "partial-delete-only"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "relay"],
            "properties": {
              "op": { "const": "relay-partition" },
              "relay": { "type": "integer", "minimum": 0, "maximum": 63 },
              "eventIds": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "maxItems": 100000
              },
              "kinds": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "maxItems": 1024
              },
              "authors": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "maxItems": 1024
              }
            },
            "anyOf": [
              { "required": ["eventIds"], "properties": { "eventIds": { "minItems": 1 } } },
              { "required": ["kinds"], "properties": { "kinds": { "minItems": 1 } } },
              { "required": ["authors"], "properties": { "authors": { "minItems": 1 } } }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "relay"],
            "properties": {
              "op": { "const": "relay-heal" },
              "relay": { "type": "integer", "minimum": 0, "maximum": 63 }
            }
          }
        ]
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codes", "ok"],
      "properties": {
        "codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "RELAY_PARTITION",
              "GHOST_TOKEN",
              "ORPHANED_PROOFS",
              "DEL_CHAIN_BREAK",
              "WALLET_EVENT_FORK",
              "DELETION_NOT_PROPAGATED",
              "HISTORY_GAP",
              "QUOTE_LIMBO",
              "MALFORMED_EVENT"
            ]
          }
        },
        "ok": { "type": "boolean" },
        "doubleCounted": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "mintVerified": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "merged": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ghost": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "orphanedUnspent": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  }
}
