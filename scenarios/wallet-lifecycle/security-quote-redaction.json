{
  "schemaVersion": 1,
  "id": "security-quote-redaction",
  "description": "Malformed quote responses and failure artifacts must never expose quote credentials or request bodies.",
  "seed": "wallet-lifecycle-v1:security-quote-redaction",
  "requireQuiescence": true,
  "requiredOperations": ["mint"],
  "commands": [
    {
      "type": "fault",
      "rule": {
        "action": "truncate_response",
        "endpoint": "quote",
        "occurrence": 1,
        "truncateBytes": 7
      }
    },
    {
      "type": "start",
      "input": {
        "operationId": "AAAAAAAAAAAAAAAAAAAAAA",
        "kind": "mint",
        "mint": "http://127.0.0.1:3338",
        "unit": "sat",
        "amount": 4,
        "method": "bolt11"
      }
    },
    { "type": "clear_faults" },
    { "type": "resume", "operationId": "AAAAAAAAAAAAAAAAAAAAAA" }
  ]
}
