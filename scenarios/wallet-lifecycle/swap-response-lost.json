{
  "schemaVersion": 1,
  "id": "swap-response-lost",
  "description": "The swap commits but its response is lost; recovery must not create a fresh output plan.",
  "seed": "wallet-lifecycle-v1:swap-response-lost",
  "requireQuiescence": true,
  "requiredOperations": ["swap"],
  "commands": [
    { "type": "fault", "rule": { "action": "drop_response", "endpoint": "swap", "occurrence": 1 } },
    {
      "type": "start",
      "input": {
        "operationId": "AAAAAAAAAAAAAAAAAAAAAA",
        "kind": "swap",
        "mint": "http://127.0.0.1:3338",
        "unit": "sat",
        "amount": 32
      }
    },
    { "type": "clear_faults" },
    { "type": "resume", "operationId": "AAAAAAAAAAAAAAAAAAAAAA" }
  ]
}
