{
  "schemaVersion": 1,
  "id": "mint-response-lost",
  "description": "The mint commits issuance but the first mint response is lost; resume must recover the same output plan.",
  "seed": "wallet-lifecycle-v1:mint-response-lost",
  "requireQuiescence": true,
  "requiredOperations": ["mint"],
  "commands": [
    { "type": "fault", "rule": { "action": "drop_response", "endpoint": "mint", "occurrence": 1 } },
    {
      "type": "start",
      "input": {
        "operationId": "AAAAAAAAAAAAAAAAAAAAAA",
        "kind": "mint",
        "mint": "http://127.0.0.1:3338",
        "unit": "sat",
        "amount": 64,
        "method": "bolt11"
      }
    },
    { "type": "clear_faults" },
    { "type": "resume", "operationId": "AAAAAAAAAAAAAAAAAAAAAA" }
  ]
}
